<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_hardware</name>
  <version>1.0.0</version>
  <description>
    ros2_control hardware interface for the physical 6-DOF robot_arm, with a
    transport abstraction (serial / RS485 / CAN / TCP / loopback), a pluggable
    motor-controller protocol, encoder and calibration handling, a software
    safety layer, an emergency stop and ROS diagnostics.
  </description>
  <maintainer email="mengkungkao@gmail.com">robot_arm maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>robot_arm_msgs</depend>
  <depend>robot_arm_interfaces</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
