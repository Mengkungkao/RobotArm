<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_bringup</name>
  <version>1.0.0</version>
  <description>
    Launch entry points for the 6-DOF robot_arm.  One command brings up the
    whole system in simulation or on the physical robot; everything above the
    ros2_control backend is identical in both cases.
  </description>
  <maintainer email="mengkungkao@gmail.com">robot_arm maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_arm_description</exec_depend>
  <exec_depend>robot_arm_control</exec_depend>
  <exec_depend>robot_arm_hardware</exec_depend>
  <exec_depend>robot_arm_simulation</exec_depend>
  <exec_depend>robot_arm_moveit_config</exec_depend>
  <exec_depend>robot_arm_tools</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- rviz.launch.py standalone:=true drives the model from sliders,
       with no controllers running. -->
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>controller_manager_msgs</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
