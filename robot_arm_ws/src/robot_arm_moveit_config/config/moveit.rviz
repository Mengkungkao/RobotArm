Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /MotionPlanning1
      Splitter Ratio: 0.5
    Tree Height: 140
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: moveit_rviz_plugin/MotionPlanning - Trajectory Slider
    Name: Trajectory Slider
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
