<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_arm_tools</name>
  <version>1.0.0</version>
  <description>
    Command-line tools for the 6-DOF robot_arm: joint and Cartesian motion,
    forward and inverse kinematics, status, stop, emergency stop and joint
    calibration.  They are thin wrappers around the Python API, so they behave
    identically in simulation and on the real robot.
  </description>
  <maintainer email="mengkungkao@gmail.com">robot_arm maintainers</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_arm_control</exec_depend>
  <exec_depend>robot_arm_msgs</exec_depend>
  <exec_depend>robot_arm_interfaces</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
