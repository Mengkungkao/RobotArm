<?xml version="1.0"?>
<!--
  Inertial properties.

  A URDF link carries exactly one inertial, which makes it easy to fake a
  composite link with a single equivalent solid.  This model does not: the
  tensors come from config/inertia.yaml, where scripts/compute_inertia.py
  writes them after summing each link's actual primitives with the parallel
  axis theorem - centre of mass, principal moments and products of inertia.

  Regenerate after any change to geometry or mass:

    xacro urdf/robot_arm.urdf.xacro > /tmp/arm.urdf
    ros2 run robot_arm_description compute_inertia.py /tmp/arm.urdf \
        config/robot.yaml > config/inertia.yaml

  A test regenerates the file and fails if it no longer matches the geometry,
  so the two cannot drift apart silently.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="link_inertial" params="spec">
    <inertial>
      <origin xyz="${spec['com'][0]} ${spec['com'][1]} ${spec['com'][2]}" rpy="0 0 0"/>
      <mass value="${spec['mass']}"/>
      <inertia
        ixx="${spec['inertia']['ixx']}"
        ixy="${spec['inertia']['ixy']}"
        ixz="${spec['inertia']['ixz']}"
        iyy="${spec['inertia']['iyy']}"
        iyz="${spec['inertia']['iyz']}"
        izz="${spec['inertia']['izz']}"/>
    </inertial>
  </xacro:macro>

</robot>
